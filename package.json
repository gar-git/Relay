{
  "name": "relay",
  "version": "1.0.0",
  "description": "Local Postman-style API client with team workspaces (max 15) and OpenAPI docs",
  "main": "dist-electron/main.js",
  "author": "Relay",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "assets:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build/generate-installer-assets.ps1",
    "build": "npm run assets:installer && tsc -p tsconfig.node.json && vite build && electron-builder --win nsis",
    "build:dir": "npm run assets:installer && tsc -p tsconfig.node.json && vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "js-yaml": "^4.1.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.relay.api",
    "productName": "Relay",
    "copyright": "Copyright © Relay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Relay-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false,
      "signtoolOptions": {
        "publisherName": "Relay"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Relay",
      "menuCategory": "Development",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license.txt",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "unicode": true,
      "warningsAsErrors": false,
      "include": "build/installer.nsh",
      "displayLanguageSelector": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
